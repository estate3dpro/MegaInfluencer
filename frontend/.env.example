# Fastify API base URL. It must include the API version prefix.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Backend route that starts the Instagram OAuth flow. Implement this backend
# route before enabling Influencer Instagram sign-in.
VITE_INSTAGRAM_LOGIN_URL=http://localhost:3000/api/v1/auth/instagram

# Optional Google Analytics 4 measurement ID for public marketing-page analytics.
VITE_GA_MEASUREMENT_ID=
