generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STORE_OWNER
  INFLUENCER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum StorePlatform {
  SHOPIFY
  WOOCOMMERCE
  CUSTOM
}

enum StoreConnectionStatus {
  PENDING
  CONNECTED
  DISABLED
}

enum ShopifyConnectionMethod {
  CLI_APP
  ADMIN_API
}

enum InstagramConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum InstagramOAuthFlow {
  LOGIN
  CONNECT
}

enum InstagramAutomationStatus {
  ACTIVE
  PAUSED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum CampaignApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

model User {
  id                    String                 @id @default(cuid())
  email                 String?                @unique
  passwordHash          String?
  displayName           String
  role                  UserRole
  status                UserStatus             @default(ACTIVE)
  ownedOrganizations    Organization[]         @relation("OrganizationOwner")
  storeAssignments      StoreInfluencerAssignment[] @relation("AssignedInfluencer")
  instagramConnection   InstagramConnection?
  instagramAutomations  InstagramAutomation[]
  instagramOAuthStates  InstagramOAuthState[]  @relation("InstagramOAuthStateInfluencer")
  instagramLoginTickets InstagramLoginTicket[]
  authSessions          AuthSession[]
  campaignApplications  CampaignApplication[]
  campaignAssignments   CampaignAssignment[] @relation("CampaignAssignedInfluencer")
  notifications         Notification[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model InstagramConnection {
  id                   String                    @id @default(cuid())
  influencerId         String                    @unique
  influencer           User                      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  instagramUserId      String                    @unique
  username             String
  displayName          String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  status               InstagramConnectionStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
}

model InstagramOAuthState {
  id           String             @id @default(cuid())
  stateHash    String             @unique
  flow         InstagramOAuthFlow
  influencerId String?
  influencer   User?              @relation("InstagramOAuthStateInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([expiresAt])
}

model InstagramLoginTicket {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model InstagramWebhookDelivery {
  id          String   @id @default(cuid())
  payloadHash String   @unique
  payload     Json
  receivedAt  DateTime @default(now())
}

model InstagramAutomation {
  id             String                    @id @default(cuid())
  influencerId   String
  influencer     User                      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  name           String
  instagramPostId String
  postUrl        String?
  postLabel      String?
  keywords       String[]
  dmMessage      String
  wholeWordMatch Boolean                   @default(true)
  status         InstagramAutomationStatus @default(ACTIVE)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([influencerId, createdAt])
  @@index([influencerId, instagramPostId])
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  platform  StorePlatform @default(SHOPIFY)
  connectionStatus StoreConnectionStatus @default(PENDING)
  category  String?
  logoUrl   String?
  shopDomain String?
  appUrl    String?
  apiUrl    String?
  shopifyConnectionMethod ShopifyConnectionMethod?
  encryptedShopifyAccessToken String?
  shopifyProducts ShopifyProduct[]
  shopifyOrders   ShopifyOrder[]
  assignments StoreInfluencerAssignment[]
  campaigns Campaign[]
  ownerId   String
  owner     User               @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([ownerId])
}

model Campaign {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title String
  brief String
  category String
  imageUrl String @default("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1200&q=80")
  campaignType String
  objective String
  deliverables String
  deliverableDetails Json?
  compensationType String @default("FIXED")
  compensationDetails Json?
  minimumFollowers Int?
  applicationType String @default("OPEN")
  budgetMin Int?
  budgetMax Int?
  currency String @default("INR")
  applicationDeadline DateTime
  contentDeadline DateTime?
  campaignEndDate DateTime?
  status CampaignStatus @default(DRAFT)
  publishedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applications CampaignApplication[]
  assignments CampaignAssignment[]
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@index([status, applicationDeadline])
}

model CampaignApplication {
  id String @id @default(cuid())
  campaignId String
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencerId String
  influencer User @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  pitch String
  proposedRate Int?
  status CampaignApplicationStatus @default(PENDING)
  decidedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([campaignId, influencerId])
  @@index([campaignId, status])
  @@index([influencerId, createdAt])
}

model CampaignAssignment {
  id           String   @id @default(cuid())
  campaignId   String
  influencerId String
  status       String   @default("ASSIGNED")
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer   User     @relation("CampaignAssignedInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, influencerId])
  @@index([influencerId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  kind      String   @default("CAMPAIGN")
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ShopifyProduct {
  id             String       @id @default(cuid())
  organizationId String
  shopifyId      String
  title          String
  handle         String?
  status         String?
  vendor         String?
  productType    String?
  descriptionHtml String?
  imageUrl       String?
  inventoryTotal Int          @default(0)
  price          String?
  currency       String?
  payload        Json
  syncedAt       DateTime     @updatedAt
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shopifyId])
  @@index([organizationId, syncedAt])
}

model ShopifyOrder {
  id             String       @id @default(cuid())
  organizationId String
  shopifyId      String
  name           String
  email          String?
  currency       String?
  total          String?
  financialStatus String?
  fulfillmentStatus String?
  processedAt    DateTime?
  payload        Json
  syncedAt       DateTime     @updatedAt
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, shopifyId])
  @@index([organizationId, syncedAt])
}

model StoreInfluencerAssignment {
  id             String       @id @default(cuid())
  organizationId String
  influencerId   String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  influencer     User         @relation("AssignedInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, influencerId])
  @@index([influencerId])
}
