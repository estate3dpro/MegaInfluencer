generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STORE_OWNER
  INFLUENCER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum StorePlatform {
  SHOPIFY
  WOOCOMMERCE
  CUSTOM
}

enum StoreConnectionStatus {
  PENDING
  CONNECTED
  DISABLED
}

enum ShopifyConnectionMethod {
  CLI_APP
  ADMIN_API
}

enum InstagramConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum InstagramOAuthFlow {
  LOGIN
  CONNECT
}

enum InstagramAutomationStatus {
  ACTIVE
  PAUSED
}

enum InstagramAutomationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum InstagramManualReplyStatus {
  PENDING
  SENT
  FAILED
}

enum InstagramDirectMessageDirection {
  INBOUND
  OUTBOUND
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  ARCHIVED
}

enum CampaignApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum AffiliateLinkStatus {
  ACTIVE
  PAUSED
}

enum AffiliateLinkTargetType {
  STORE
  PRODUCT
  COLLECTION
}

enum AffiliateCommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum PayoutType {
  FIXED_FEE
  HYBRID_BASE
  BONUS
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum SampleFulfillmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

model User {
  id                            String                         @id @default(cuid())
  email                         String?                        @unique
  passwordHash                  String?
  displayName                   String
  role                          UserRole
  status                        UserStatus                     @default(ACTIVE)
  creatorCode                   String?                        @unique
  influencerProfile             InfluencerProfile?
  customerProfile               CustomerProfile?
  customerRewards               CustomerRewardClaim[]
  milestoneClaims               CustomerMilestoneClaim[]
  ownedOrganizations            Organization[]                 @relation("OrganizationOwner")
  storeAssignments              StoreInfluencerAssignment[]    @relation("AssignedInfluencer")
  productAssignments            ProductInfluencerAssignment[]  @relation("ProductAssignedInfluencer")
  instagramConnection           InstagramConnection?
  instagramAutomations          InstagramAutomation[]
  instagramCommentConversations InstagramCommentConversation[] @relation("InstagramConversationInfluencer")
  instagramManualReplies        InstagramManualReply[]         @relation("InstagramManualReplySender")
  instagramDirectConversations  InstagramDirectConversation[]  @relation("InstagramDirectConversationInfluencer")
  instagramDirectMessages       InstagramDirectMessage[]       @relation("InstagramDirectMessageSender")
  instagramOAuthStates          InstagramOAuthState[]          @relation("InstagramOAuthStateInfluencer")
  instagramLoginTickets         InstagramLoginTicket[]
  authSessions                  AuthSession[]
  campaignApplications          CampaignApplication[]
  campaignAssignments           CampaignAssignment[]           @relation("CampaignAssignedInfluencer")
  affiliateLinks                AffiliateLink[]
  affiliateCommissions          AffiliateCommission[]
  discountCodes                 DiscountCode[]
  notifications                 Notification[]
  campaignPayouts               CampaignPayout[]
  barterFulfillments            BarterSampleFulfillment[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model InstagramConnection {
  id                   String                    @id @default(cuid())
  influencerId         String                    @unique
  influencer           User                      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  instagramUserId      String                    @unique
  username             String
  displayName          String?
  encryptedAccessToken String
  tokenExpiresAt       DateTime?
  status               InstagramConnectionStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
}

model InstagramOAuthState {
  id           String             @id @default(cuid())
  stateHash    String             @unique
  flow         InstagramOAuthFlow
  influencerId String?
  influencer   User?              @relation("InstagramOAuthStateInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime           @default(now())

  @@index([expiresAt])
}

model InstagramLoginTicket {
  id         String    @id @default(cuid())
  codeHash   String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

model InstagramWebhookDelivery {
  id          String   @id @default(cuid())
  payloadHash String   @unique
  payload     Json
  receivedAt  DateTime @default(now())
}

model InstagramAutomation {
  id                             String                        @id @default(cuid())
  influencerId                   String
  influencer                     User                          @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  name                           String
  instagramPostId                String
  postUrl                        String?
  postLabel                      String?
  keywords                       String[]
  dmMessage                      String
  fallbackMessage                String?
  fallbackEnabled                Boolean                       @default(true)
  wholeWordMatch                 Boolean                       @default(true)
  replyToAnyComment              Boolean                       @default(false)
  replyOnDuplicateCommentWebhook Boolean                       @default(false)
  status                         InstagramAutomationStatus     @default(ACTIVE)
  deliveries                     InstagramAutomationDelivery[]
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt

  @@index([influencerId, createdAt])
  @@index([influencerId, instagramPostId])
}

model InfluencerProfile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  phone             String?  @unique
  profileImageUrl   String?
  bio               String?
  city              String?
  country           String?
  preferredLanguage String?
  niches            String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InstagramAutomationDelivery {
  id                String                            @id @default(cuid())
  automationId      String
  commentId         String
  attemptKey        String
  commenterId       String
  commenterName     String?
  commentText       String
  status            InstagramAutomationDeliveryStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  fallbackSent      Boolean                           @default(false)
  fallbackMessage   String?
  fallbackError     String?
  fallbackSentAt    DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt
  automation        InstagramAutomation               @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, attemptKey])
  @@index([automationId, createdAt])
  @@index([automationId, commentId])
  @@index([status, createdAt])
}

// A durable inbox record is created for every recognised Instagram comment.
// It is intentionally independent from automation deliveries: a comment can
// be replied to manually even when no automation rule sends a DM.
model InstagramCommentConversation {
  id                 String                 @id @default(cuid())
  influencerId       String
  instagramCommentId String                 @unique
  commenterId        String
  commenterUsername  String?
  commentText        String
  instagramMediaId   String
  instagramAccountId String?
  influencer         User                   @relation("InstagramConversationInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  manualReplies      InstagramManualReply[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([influencerId, updatedAt])
  @@index([instagramMediaId])
}

model InstagramManualReply {
  id                String                       @id @default(cuid())
  conversationId    String
  senderUserId      String
  senderRole        UserRole
  message           String
  status            InstagramManualReplyStatus   @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  conversation      InstagramCommentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            User                         @relation("InstagramManualReplySender", fields: [senderUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model InstagramDirectConversation {
  id                     String                   @id @default(cuid())
  influencerId           String
  instagramParticipantId String
  participantUsername    String?
  instagramAccountId     String
  lastMessageAt          DateTime                 @default(now())
  influencer             User                     @relation("InstagramDirectConversationInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  messages               InstagramDirectMessage[]
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@unique([influencerId, instagramParticipantId])
  @@index([influencerId, lastMessageAt])
}

model InstagramDirectMessage {
  id                 String                          @id @default(cuid())
  conversationId     String
  instagramMessageId String?                         @unique
  senderUserId       String?
  direction          InstagramDirectMessageDirection
  messageText        String
  sentAt             DateTime
  conversation       InstagramDirectConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             User?                           @relation("InstagramDirectMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime                        @default(now())

  @@index([conversationId, sentAt])
}

model Organization {
  id                          String                        @id @default(cuid())
  name                        String
  slug                        String                        @unique
  status                      OrganizationStatus            @default(ACTIVE)
  platform                    StorePlatform                 @default(SHOPIFY)
  connectionStatus            StoreConnectionStatus         @default(PENDING)
  category                    String?
  logoUrl                     String?
  shopDomain                  String?
  appUrl                      String?
  apiUrl                      String?
  shopifyConnectionMethod     ShopifyConnectionMethod?
  encryptedShopifyAccessToken String?
  shopifyProducts             ShopifyProduct[]
  shopifyCollections          ShopifyCollection[]
  shopifyOrders               ShopifyOrder[]
  affiliateLinks              AffiliateLink[]
  affiliateClicks             AffiliateLinkClick[]
  affiliateCommissions        AffiliateCommission[]
  assignments                 StoreInfluencerAssignment[]
  productAssignments          ProductInfluencerAssignment[]
  campaigns                   Campaign[]
  discountCodes               DiscountCode[]
  campaignPayouts             CampaignPayout[]
  barterFulfillments          BarterSampleFulfillment[]
  referralConfig              StoreReferralConfig?
  referralOffers              StoreReferralOffer[]
  rewardItems                 StoreRewardItem[]
  referralMilestones          StoreReferralMilestone[]
  ownerId                     String
  owner                       User                          @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@index([ownerId])
}

model Campaign {
  id                  String                    @id @default(cuid())
  organizationId      String
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId           String?
  product             ShopifyProduct?           @relation("CampaignProduct", fields: [productId], references: [id], onDelete: SetNull)
  title               String
  brief               String
  category            String
  imageUrl            String                    @default("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1200&q=80")
  campaignType        String
  objective           String
  deliverables        String
  deliverableDetails  Json?
  compensationType    String                    @default("FIXED")
  compensationDetails Json?
  minimumFollowers    Int?
  applicationType     String                    @default("OPEN")
  budgetMin           Int?
  budgetMax           Int?
  currency            String                    @default("INR")
  applicationDeadline DateTime
  contentDeadline     DateTime?
  campaignEndDate     DateTime?
  status              CampaignStatus            @default(DRAFT)
  publishedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  applications        CampaignApplication[]
  assignments         CampaignAssignment[]
  payouts             CampaignPayout[]
  barterFulfillments  BarterSampleFulfillment[]

  @@index([organizationId, status])
  @@index([productId])
  @@index([organizationId, deletedAt])
  @@index([status, applicationDeadline])
}

model CampaignApplication {
  id           String                    @id @default(cuid())
  campaignId   String
  campaign     Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   User                      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  pitch        String
  proposedRate Int?
  status       CampaignApplicationStatus @default(PENDING)
  decidedAt    DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([campaignId, influencerId])
  @@index([campaignId, status])
  @@index([influencerId, createdAt])
}

model CampaignAssignment {
  id           String   @id @default(cuid())
  campaignId   String
  influencerId String
  status       String   @default("ASSIGNED")
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer   User     @relation("CampaignAssignedInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, influencerId])
  @@index([influencerId, status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  kind      String    @default("CAMPAIGN")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model ShopifyProduct {
  id                       String                        @id @default(cuid())
  organizationId           String
  shopifyId                String
  title                    String
  handle                   String?
  status                   String?
  vendor                   String?
  productType              String?
  descriptionHtml          String?
  imageUrl                 String?
  inventoryTotal           Int                           @default(0)
  price                    String?
  currency                 String?
  payload                  Json
  syncedAt                 DateTime                      @updatedAt
  createdAt                DateTime                      @default(now())
  organization             Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affiliateLinks           AffiliateLink[]
  affiliateLinkCollections AffiliateLinkProduct[]
  collectionMemberships      ShopifyCollectionProduct[]
  productAssignments       ProductInfluencerAssignment[]
  campaigns                Campaign[]                    @relation("CampaignProduct")
  barterFulfillments       BarterSampleFulfillment[]

  @@unique([organizationId, shopifyId])
  @@index([organizationId, syncedAt])
}

model ShopifyCollection {
  id              String                     @id @default(cuid())
  organizationId  String
  shopifyId       String
  title           String
  handle          String?
  descriptionHtml String?
  imageUrl        String?
  productCount    Int                        @default(0)
  payload         Json
  syncedAt        DateTime                   @updatedAt
  createdAt       DateTime                   @default(now())
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products        ShopifyCollectionProduct[]
  affiliateLinks  AffiliateLink[]

  @@unique([organizationId, shopifyId])
  @@index([organizationId, syncedAt])
}

model ShopifyCollectionProduct {
  id           String            @id @default(cuid())
  collectionId String
  productId    String
  position     Int               @default(0)
  collection   ShopifyCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      ShopifyProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([productId])
  @@index([collectionId, position])
}

model ShopifyOrder {
  id                   String                @id @default(cuid())
  organizationId       String
  shopifyId            String
  name                 String
  email                String?
  currency             String?
  total                String?
  financialStatus      String?
  fulfillmentStatus    String?
  processedAt          DateTime?
  creatorCode          String?
  affiliateLinkId      String?
  payload              Json
  syncedAt             DateTime              @updatedAt
  createdAt            DateTime              @default(now())
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  affiliateLink        AffiliateLink?        @relation("AffiliateTrackedOrders", fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  affiliateCommissions AffiliateCommission[]

  @@unique([organizationId, shopifyId])
  @@index([organizationId, syncedAt])
  @@index([organizationId, creatorCode])
  @@index([affiliateLinkId])
}

model AffiliateLink {
  id              String                  @id @default(cuid())
  organizationId  String
  creatorId       String?
  productId       String?
  collectionId    String?
  slug            String                  @unique
  targetType      AffiliateLinkTargetType @default(STORE)
  destinationPath String                  @default("/")
  commissionRate  Decimal                 @default(10) @db.Decimal(5, 2)
  status          AffiliateLinkStatus     @default(ACTIVE)
  expiresAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User?                   @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  product         ShopifyProduct?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  collection      ShopifyCollection?      @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  products        AffiliateLinkProduct[]
  clicks          AffiliateLinkClick[]
  commissions     AffiliateCommission[]
  trackedOrders   ShopifyOrder[]          @relation("AffiliateTrackedOrders")

  @@index([organizationId, status])
  @@index([creatorId, createdAt])
  @@index([productId])
  @@index([collectionId])
}

model AffiliateLinkProduct {
  id              String         @id @default(cuid())
  affiliateLinkId String
  productId       String
  position        Int            @default(0)
  createdAt       DateTime       @default(now())
  affiliateLink   AffiliateLink  @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  product         ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([affiliateLinkId, productId])
  @@index([productId])
  @@index([affiliateLinkId, position])
}

model AffiliateLinkClick {
  id             String        @id @default(cuid())
  organizationId String
  linkId         String
  visitorHash    String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  link           AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@index([organizationId, createdAt])
}

model AffiliateCommission {
  id             String                    @id @default(cuid())
  organizationId String
  linkId         String
  creatorId      String?
  shopifyOrderId String
  orderAmount    Decimal                   @db.Decimal(12, 2)
  commissionRate Decimal                   @db.Decimal(5, 2)
  amount         Decimal                   @db.Decimal(12, 2)
  status         AffiliateCommissionStatus @default(PENDING)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  link           AffiliateLink             @relation(fields: [linkId], references: [id], onDelete: Restrict)
  creator        User?                     @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  shopifyOrder   ShopifyOrder              @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)

  @@unique([shopifyOrderId])
  @@index([organizationId, creatorId, status])
}

model StoreInfluencerAssignment {
  id               String       @id @default(cuid())
  organizationId   String
  influencerId     String
  compensationMode String       @default("COMMISSION")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  influencer       User         @relation("AssignedInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@unique([organizationId, influencerId])
  @@index([influencerId])
}

model ProductInfluencerAssignment {
  id             String         @id @default(cuid())
  organizationId String
  productId      String
  influencerId   String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        ShopifyProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  influencer     User           @relation("ProductAssignedInfluencer", fields: [influencerId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([productId, influencerId])
  @@index([influencerId])
  @@index([organizationId])
  @@index([productId])
}

model DiscountCode {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  description    String?
  discountType   String       @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT, FREE_SHIPPING
  value          Decimal      @default(10) @db.Decimal(10, 2)
  currency       String       @default("INR")
  creatorId      String?
  status         String       @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  startsAt       DateTime?    @default(now())
  expiresAt      DateTime?
  usageLimit     Int?
  usageCount     Int          @default(0)
  totalSavings   Decimal      @default(0) @db.Decimal(12, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User?        @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([creatorId])
}

model CampaignPayout {
  id             String       @id @default(cuid())
  organizationId String
  campaignId     String
  creatorId      String
  type           PayoutType   @default(FIXED_FEE)
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("INR")
  status         PayoutStatus @default(PENDING)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator      User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([organizationId, creatorId, status])
  @@index([campaignId])
}

model BarterSampleFulfillment {
  id              String                  @id @default(cuid())
  organizationId  String
  campaignId      String
  creatorId       String
  productId       String?
  productTitle    String
  trackingNumber  String?
  carrier         String?
  shippingAddress String?
  status          SampleFulfillmentStatus @default(PENDING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creator      User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  product      ShopifyProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId, creatorId, status])
  @@index([campaignId])
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  RESOLVED
  ARCHIVED
}

model ContactInquiry {
  id         String        @id @default(cuid())
  fullName   String
  email      String
  subject    String
  message    String
  status     InquiryStatus @default(NEW)
  adminNotes String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model CustomerProfile {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  avatarUrl     String?
  tier          String   @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  pointsBalance Int      @default(0)
  totalEarned   Decimal  @default(0) @db.Decimal(12, 2)
  payoutMethod  String? // UPI, PAYPAL, BANK, STORE_CREDIT
  payoutDetails Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomerRewardClaim {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  rewardTitle    String
  rewardType     String // DISCOUNT_CODE, CASH_PAYOUT, GIFT_CARD, STORE_CREDIT
  rewardValue    Decimal  @db.Decimal(12, 2)
  pointsCost     Int
  code           String?
  status         String   @default("COMPLETED") // COMPLETED, PENDING, REJECTED
  details        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
}

enum ReferralRewardMode {
  POINTS // Points + Rewards Store + VIP Tiers
  CASHBACK_COMMISSION // Direct cash wallet + UPI/Bank payouts (no points)
  DISCOUNT_ONLY // Store coupon codes only
  HYBRID // Both points and cash withdrawal
}

enum MultiProductCommissionMode {
  STORE_WIDE // Commission earned on whole order subtotal regardless of items
  ASSIGNED_PRODUCTS_ONLY // Commission calculated strictly on line items matching assigned products
  GATE_REQUIRED // Earn commission on whole cart subtotal ONLY if at least one assigned product is present
  HYBRID_FALLBACK // Full rate on assigned items + fallback rate on unassigned items in cart
}

model StoreReferralConfig {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Program Engine Master Switch
  isEnabled  Boolean            @default(true)
  rewardMode ReferralRewardMode @default(POINTS)

  // Multi-Product Commission Calculation Policy
  multiProductCommissionMode MultiProductCommissionMode @default(STORE_WIDE)
  fallbackCommissionRate     Decimal                    @default(0) @db.Decimal(5, 2)

  // Rule 1: Percentage of Order Rule (Inactivable)
  percentageEnabled Boolean @default(true)
  commissionRate    Decimal @default(10) @db.Decimal(5, 2)
  pointsPerCurrency Int     @default(1)

  // Rule 2: Spend Ratio Rule - X Tokens per Y Amount Spent (Inactivable)
  spendTokensEnabled Boolean @default(false)
  spendTokensRate    Int     @default(10)
  spendTokensAmount  Decimal @default(100) @db.Decimal(10, 2)

  // Rule 3: Fixed Flat Tokens Per Order Rule (Inactivable)
  fixedTokensEnabled  Boolean @default(false)
  fixedTokensPerOrder Int     @default(50)

  // Rule 4: Welcome / Signup Bonus Rule (Inactivable)
  welcomeBonusEnabled Boolean @default(true)
  welcomeBonusPoints  Int     @default(100)

  minPayoutAmount Decimal @default(500) @db.Decimal(10, 2)

  // Friend Discount Offer (Inactivable)
  friendDiscountEnabled Boolean @default(true)
  friendDiscountType    String  @default("PERCENTAGE") // PERCENTAGE | FIXED | FREE_SHIPPING
  friendDiscountValue   Decimal @default(10) @db.Decimal(10, 2)

  // UI Visibility Controls (What store admin decides to show/hide)
  showTierRoadmap       Boolean @default(true)
  showPerformanceCharts Boolean @default(true)
  showRewardsStore      Boolean @default(true)
  showRecentPurchases   Boolean @default(true)

  // Custom Branding / Messaging
  programTitle       String? @default("Customer Advocate & Referral Rewards")
  customShareMessage String? @default("Get 10% off with my link, and support me!")
  accentColor        String? @default("#6c5ce7")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StoreReferralOffer {
  id                  String             @id @default(cuid())
  organizationId      String
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  rewardMode          ReferralRewardMode @default(POINTS)
  advocateRewardRate  Decimal            @default(10) @db.Decimal(5, 2)
  friendDiscountType  String             @default("PERCENTAGE") // PERCENTAGE | FIXED | FREE_SHIPPING
  friendDiscountValue Decimal            @default(10) @db.Decimal(10, 2)
  status              String             @default("ACTIVE") // ACTIVE | PAUSED | EXPIRED
  isFeatured          Boolean            @default(false)
  badgeText           String?
  bannerText          String?
  startsAt            DateTime?          @default(now())
  expiresAt           DateTime?
  usageCount          Int                @default(0)
  totalSales          Decimal            @default(0) @db.Decimal(12, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([organizationId, status])
}

model StoreRewardItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String       @default("DISCOUNT_CODE") // DISCOUNT_CODE, PRODUCT_LINK, GIFT_CARD, STORE_CREDIT, CASH_PAYOUT, PRODUCT_GIFT
  pointsCost     Int          @default(500)
  rewardValue    Decimal      @default(500) @db.Decimal(10, 2)
  category       String       @default("VOUCHER") // VOUCHER, PRODUCT, CASH, GIFT, PERK
  badge          String? // POPULAR, HOT, VIP, DIAMOND, EXCLUSIVE
  icon           String?      @default("Gift")
  couponCode     String? // Explicit promo discount code (e.g. "VIP20OFF", "FLAT500")
  productName    String? // Name of assigned product/gift item
  productLink    String? // Destination URL to the product
  codeTemplate   String? // e.g. "VIP-{RANDOM}", "SAVE10"
  stockQuantity  Int? // null = unlimited
  status         String       @default("ACTIVE") // ACTIVE, PAUSED, OUT_OF_STOCK
  minTier        String? // BRONZE, SILVER, GOLD, PLATINUM
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model StoreReferralMilestone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  targetType     String       @default("REFERRAL_COUNT") // REFERRAL_COUNT, SALES_AMOUNT
  targetValue    Decimal      @default(5) @db.Decimal(10, 2)
  rewardType     String       @default("POINTS") // POINTS, DISCOUNT_CODE, GIFT_CARD, CASH_PAYOUT, PRODUCT_GIFT
  pointsBonus    Int          @default(250)
  rewardValue    Decimal      @default(250) @db.Decimal(10, 2)
  badgeText      String? // e.g. "STARTER", "PRO", "LEGEND", "VIP"
  icon           String?      @default("Trophy")
  status         String       @default("ACTIVE") // ACTIVE, PAUSED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  claims CustomerMilestoneClaim[]

  @@index([organizationId, status])
}

model CustomerMilestoneClaim {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneId   String
  milestone     StoreReferralMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  pointsAwarded Int                    @default(0)
  rewardValue   Decimal                @default(0) @db.Decimal(10, 2)
  claimedAt     DateTime               @default(now())

  @@unique([userId, milestoneId])
  @@index([userId])
}
