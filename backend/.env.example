# PostgreSQL connection string. Create the database before running migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mega_influencer?schema=public"
# Use a separate database for automated integration tests; never point this to production.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mega_influencer_test?schema=public"

# Authentication. Generate a unique, high-entropy value (for example: openssl rand -base64 48).
JWT_SECRET="replace-with-a-unique-long-random-secret"

# Required only by `npm run admin:bootstrap`; never commit real credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Platform Admin"

# HTTP server
PORT=3000
HOST="0.0.0.0"

# Pino logging. Development logs are formatted with pino-pretty; production logs stay JSON.
NODE_ENV="development"
LOG_LEVEL="info"

# Comma-separated browser origins allowed to call the API.
CLIENT_ORIGIN="https://megainfluencer.megascale.co.in"

# Public application URLs. Both must use HTTPS in production; Meta rejects
# webhook callback URLs served over plain HTTP.
FRONTEND_ORIGIN="https://megainfluencer.megascale.co.in"
PUBLIC_BASE_URL="https://api-megainfluencer.megascale.co.in"
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
META_APP_SECRET=""
WEBHOOK_VERIFY_TOKEN=""
# 64 hexadecimal characters; generate with `openssl rand -hex 32`.
ENCRYPTION_KEY=""
